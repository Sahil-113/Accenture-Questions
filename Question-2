

#include <bits/stdc++.h>
using namespace std;


long Productsmallpair(long sum,vector<long>arr){
    long n=arr.size();
    if(n<2){
        return -1;
    }
    sort(arr.begin(),arr.end());
    if(arr[0]+arr[1]<=sum){
        return arr[0]*arr[1];
    }
    else{
        return 0;
    }
}

int main()
{
    long n,sum;
    cin>>n>>sum;
    vector<long>arr(n);
    for(long i=0;i<n;i++){
        cin>>arr[i];
    }
    cout<<Productsmallpair(sum,arr)<<endl;

    return 0;
}
